# Copy this file to .env only for local reference. Never commit real values.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/japlearn?retryWrites=true&w=majority
MONGODB_DATABASE=japlearn
BREVO_SMTP_LOGIN=your-brevo-smtp-login
BREVO_SMTP_PASSWORD=your-brevo-smtp-key
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
MAIL_FROM_ADDRESS=japlearnofficial@gmail.com
APP_BACKEND_URL=https://your-backend-service.onrender.com
APP_STUDENT_WEB_URL=https://japlearn.com
SPRING_WEB_LOG_LEVEL=INFO
TOMCAT_LOG_LEVEL=INFO
AZURE_SPEECH_KEY=your-server-side-azure-speech-key
AZURE_SPEECH_REGION=southeastasia
GEMINI_API_KEY=your-server-side-gemini-api-key
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
SUMI_GEMINI_VOICE=Aoede
